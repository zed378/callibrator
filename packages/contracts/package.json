{
  "name": "@callibrator/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Request schemas shared by the backend validators and the frontend's API types (P9-22, ADR-097)",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit && node ../../node_modules/@typescript/native/bin/tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "cd ../../backend && node --experimental-vm-modules --disable-warning=ExperimentalWarning ../node_modules/jest/bin/jest.js --config ../packages/contracts/jest.config.js"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
