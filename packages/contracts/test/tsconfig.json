{
  // The package's own tests run under jest on Node, so they (and only they)
  // see the Node and jest types. `npm run typecheck` checks both configs.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "types": ["node", "jest"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["./**/*.ts"]
}
