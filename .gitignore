# .gitignore

# Dependencies
node_modules/

# Lockfiles: package-lock.json IS committed (A-21, ADR-044). It is the tree the
# test suite and the lint gate are actually proven against. The other two are
# ignored deliberately — three lockfiles is three answers to one question, and
# the ESLint 9-vs-10 hoist that made `make verify` impossible (A-34) is what a
# floating tree costs.
pnpm-lock.yaml
bun.lock
# A nested lockfile in a workspace silently produces a different tree than the
# hoisted root one. That is how A-34 happened.
backend/package-lock.json
frontend/package-lock.json

# Build outputs
dist/
build/
.next/
out/
coverage/

# Environment — every env filename, in every workspace (S-25). The two
# templates (backend/.env.example, deploy/compose/.env.example) are the only
# env files that belong in git.
.env
.env.*
*.env
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# OS
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp

# Docker
docker-compose.override.yaml

# Database
*.db
*.sqlite
postgres_data/

# Redis
dump.rdb

# Certificates and keys
*.pem
*.key
*.cert

# Archive
*.zip
*.tar.gz

# Uploads
uploads/
public/uploads/
# ...except the default avatar, which is tracked (owner request, 2026-09-24).
# git cannot re-include a file inside an ignored directory, so each level is
# re-opened and then closed again.
!backend/uploads/
backend/uploads/*
!backend/uploads/profile/
backend/uploads/profile/*
!backend/uploads/profile/default.svg

# Cache
.turbo/
.eslintcache

# Testing
.nyc_output/

# Git
.git/

# ==========================================================================
# Deployment
# ==========================================================================
# Runtime data for the compose stack. deploy/compose/volumes/redis in
# particular holds in-flight worker idempotency claims — losing it reopens the
# duplicate window (docs/ARCHITECTURE/07).
deploy/compose/volumes/
deploy/compose/.env
deploy/compose/nginx/certs/

# Database dumps from `make backup`. A dump is not a backup on its own: without
# CERT_SIGNING_SECRET and ENCRYPT_KEY, restoring it produces a system that
# starts cleanly and cannot verify a single certificate.
backups/

# Helm
deploy/helm/**/charts/*.tgz
deploy/helm/**/Chart.lock
