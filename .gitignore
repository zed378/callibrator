# .gitignore

# Dependencies
node_modules/
pnpm-lock.yaml
package-lock.json
bun.lock

# Build outputs
dist/
build/
.next/
out/
coverage/

# Environment
.env
.env.local
.env.*.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# OS
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp

# Docker
docker-compose.override.yaml

# Database
*.db
*.sqlite
postgres_data/

# Redis
dump.rdb

# Certificates and keys
*.pem
*.key
*.cert

# Archive
*.zip
*.tar.gz

# Uploads
uploads/
public/uploads/

# Cache
.turbo/
.eslintcache

# Testing
.nyc_output/

# Git
.git/

# ==========================================================================
# Deployment
# ==========================================================================
# Runtime data for the compose stack. deploy/compose/volumes/redis in
# particular holds in-flight worker idempotency claims — losing it reopens the
# duplicate window (docs/ARCHITECTURE/07).
deploy/compose/volumes/
deploy/compose/.env
deploy/compose/nginx/certs/

# Database dumps from `make backup`. A dump is not a backup on its own: without
# CERT_SIGNING_SECRET and ENCRYPT_KEY, restoring it produces a system that
# starts cleanly and cannot verify a single certificate.
backups/

# Helm
deploy/helm/**/charts/*.tgz
deploy/helm/**/Chart.lock
