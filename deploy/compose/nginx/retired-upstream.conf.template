# P28-03: activate only at the operator-approved upstream retirement.
# Render ONLY APP_ORIGIN and LEGACY_HOST. Keep nginx variables unchanged.
limit_req_zone $binary_remote_addr zone=retired_stickers:10m rate=30r/m;
server {
    listen 80;
    server_name ${LEGACY_HOST};
    root /usr/share/nginx/html/legacy-stickers;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    limit_req_status 429;
    sub_filter_once off;
    sub_filter '__STICKER__' '$sticker';
    location ~ "^/readQr/(?<sticker>[A-Za-z0-9]{1,64})/?$" {
        limit_req zone=retired_stickers burst=10 nodelay;
        try_files /notice.html =404;
    }
    error_page 410 =410 /retired.html;
    location = /retired.html { internal; }
    location / { return 410; }
}
