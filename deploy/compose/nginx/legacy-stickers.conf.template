# P27-02: separate legacy host behind the operator's HTTPS terminator.
# Render ONLY APP_ORIGIN and LEGACY_HOST (see TASKS/RUNBOOK-LEGACY-STICKERS.md).
limit_req_zone $binary_remote_addr zone=legacy_stickers:10m rate=30r/m;
server {
    listen 80;
    server_name ${LEGACY_HOST};
    root /usr/share/nginx/html/legacy-stickers;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    limit_req_status 429;
    # Static serving reaches limit_req; a return would bypass its access phase.
    sub_filter_once off;
    sub_filter '__STICKER__' '$sticker';
    location ~ "^/readQr/(?<sticker>[A-Za-z0-9]{1,64})/?$" {
        limit_req zone=legacy_stickers burst=10 nodelay;
        try_files /notice.html =404;
    }
    location / {
        limit_req zone=legacy_stickers burst=10 nodelay;
        try_files /notice.html =404;
    }
}
