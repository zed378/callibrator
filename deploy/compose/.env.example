# Callibrator — compose environment
#
#   cp .env.example .env    (or: make env)
#
# Values here reach the backend container via `env_file`. The full variable
# reference is docs/BACKEND/11-CONFIGURATION.md.
#
# NEVER commit .env.

# ==========================================================================
# IMAGES
# ==========================================================================
BACKEND_IMAGE=callibrator/backend
FRONTEND_IMAGE=callibrator/frontend
# Required in staging and production. `:latest` in production means nobody can
# say what is running, and a rollback has nothing to roll back to.
#
# DELIBERATELY EMPTY (S-10). The prod and staging overlays require it with
# `${IMAGE_TAG:?}`, which rejects only an unset or EMPTY value — a template
# shipping `latest` pre-satisfied that guard. Set it to the image's commit sha.
# Compose cannot refuse the literal "latest"; `make deploy` / `make preflight`
# do (they pass TAG=<sha> and refuse TAG=latest). dev and vm fall back to
# `latest` via the base file's `${IMAGE_TAG:-latest}`, which is correct there.
IMAGE_TAG=

# ==========================================================================
# REQUIRED SECRETS — the application EXITS without these
# ==========================================================================
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# BACK THESE UP SEPARATELY FROM THE DATABASE. A restore that recovers the data
# and loses them produces a system that starts cleanly and is permanently
# broken: every issued certificate fails public verification (the key cannot be
# re-derived) and every wrapped credential becomes undecryptable.
CERT_SIGNING_SECRET=CHANGE_ME_64_HEX
ENCRYPT_KEY=CHANGE_ME_64_HEX
ATTACHMENT_URL_SECRET=CHANGE_ME_64_HEX

# A FOURTH required secret. src/services/kms.service.js refuses to start in
# production without it:
#   "KMS_MASTER_KEY must be set in production (64-char hex / 32-byte key)."
# It wraps tenant storage credentials, so losing it has the same consequence
# as losing ENCRYPT_KEY. BACK IT UP WITH THE OTHERS.
#
# Found only by deploying: it was absent from this file AND from
# docs/BACKEND/11-CONFIGURATION.md, and the container crash-looped with the
# error written to a log file rather than to stdout.
KMS_MASTER_KEY=CHANGE_ME_64_HEX

# KEY ROTATION (P6-10, S-08, S-26) — leave these unset except DURING a rotation.
# The old key goes here while the new one is current; every stored value and
# every token under the old key keeps working until it is removed.
# Procedure: docs/SECURITY/13-KEY-ROTATION.md.
# KMS_MASTER_KEY_PREVIOUS=
# ENCRYPT_KEY_PREVIOUS=
# JWT_ACCESS_SECRET_PREVIOUS=

# ==========================================================================
# DATABASE  (PostgreSQL only — ADR-039)
# ==========================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=callibrator
DB_USER=callibrator
DB_PASS=CHANGE_ME
# P6-03 — after migrating, the backend drops every connection to this NOLOGIN
# role (created by migration 0057), which has no UPDATE/DELETE on
# calibration_records. DB_USER above stays the owner that migrates. Unset =
# every query runs as the owner (a boot warning says so).
DB_APP_ROLE=callibrator_app
DB_DIALECT=postgres
DB_SSL=false
# DB_POOL_MAX=20
# DB_POOL_MIN=2
# DB_POOL_ACQUIRE_TIMEOUT=30000     # matches the 30s request timeout, on purpose
# DB_POOL_IDLE_TIMEOUT=10000

# ==========================================================================
# INFRASTRUCTURE
# ==========================================================================
# Redis authentication (S-09). Redis holds the brute-force lockout counters
# and the WebAuthn/OIDC state, so an unauthenticated Redis lets anything on the
# compose network flush a lockout. With REDIS_PASSWORD set, the compose Redis
# starts with `--requirepass` and the backend sends AUTH with the same value —
# ONE variable, read by both, so they cannot disagree. REDIS_URL stays
# credential-free. `make secrets` prints one; `make preflight` refuses staging
# and prod without it.
#
# Empty = no authentication, exactly as before (backward compatible). An
# EXISTING stack picks the password up on its next `up` — Redis keeps no
# password in its data volume, so nothing else needs migrating.
REDIS_PASSWORD=
# REDIS_USERNAME=      # an ACL user (Redis 6+); leave unset for `default`
REDIS_URL=redis://redis:6379
# RabbitMQ: ONE credential, stated once (S-09). RABBITMQ_USER / RABBITMQ_PASS
# CREATE the broker's user (docker-compose.yml → RABBITMQ_DEFAULT_USER/PASS);
# RABBITMQ_URL is what the backend CONNECTS with. They must agree. This file
# used to ship `guest:guest` in the URL next to RABBITMQ_PASS=CHANGE_ME, so
# changing the password as instructed produced a broker the backend could not
# authenticate to. Change the password in BOTH places, or in neither.
#
# The broker only creates its user on FIRST boot (an empty volumes/rabbitmq).
# Changing these later does not change an existing broker's password.
RABBITMQ_USER=callibrator
RABBITMQ_PASS=CHANGE_ME
RABBITMQ_URL=amqp://callibrator:CHANGE_ME@rabbitmq:5672
# MQTT is OFF unless BOTH of these are set. The backend is a CLIENT of an
# external broker; no broker is embedded (there is no aedes server).
# A publisher allowed on `device/#` can post readings for any device whose id
# and tenant id it knows, so the broker's ACLs are the control.
# MQTT_HOST=0.0.0.0
# MQTT_PORT=1883

# How long a queue consumer's deduplication claim is held in Redis. A
# redelivered message inside this window is acknowledged without doing the work
# again. Default 86400 (24h). This is at-least-once with a claim, NOT
# exactly-once: with Redis down there is no deduplication at all (fail open).
# QUEUE_DEDUP_TTL_SECONDS=86400

# Readiness probes. Each dependency probe is given a deadline, and the
# aggregate is cached so a load-balancer poll does not re-probe every hit.
# The gated /api/v1/health endpoint always probes fresh.
# HEALTH_PROBE_TIMEOUT_MS=2000
# HEALTH_CACHE_TTL_MS=5000

# ==========================================================================
# JWT
# ==========================================================================
# These two MUST DIFFER — the backend now REFUSES TO START if they are equal
# (A-31). Equal secrets mean an access token can be presented as a refresh
# token. JWT_ALGORITHM, if set, must be one the code pins (HS256/384/512,
# RS256/384/512, ES256/384/512); anything else also refuses to start.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRED=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT
JWT_REFRESH_EXPIRED=7d

# ==========================================================================
# APPLICATION
# ==========================================================================
# NODE_ENV gates CORS behaviour, the rate limit, error detail and pool size.
NODE_ENV=production
HOST_URL=https://callibrator.example.com
# Explicit, comma-separated. A wildcard is NEVER honoured: this CORS policy
# runs with credentials:true.
CORS_ORIGIN=https://callibrator.example.com
FORCE_HTTPS=true
# Production default 5000 / 15 min. Outside production it is 100000, because a
# full browser E2E run exhausts a normal budget and then fails for reasons
# unrelated to the code under test.
# RATE_LIMIT_MAX=5000
TZ=Asia/Jakarta

# ==========================================================================
# CERTIFICATES
# ==========================================================================
# The QR encodes <this>/<certificateNumber>. The verification page is public
# and unauthenticated by design.
CERT_VERIFY_BASE_URL=https://callibrator.example.com/verify

# ==========================================================================
# EMAIL
# ==========================================================================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@callibrator.example.com

# ==========================================================================
# OBJECT STORAGE
# ==========================================================================
# local | s3 | nfs.  `local` is INCOMPATIBLE with more than one backend
# replica: replica A writes an attachment, replica B cannot serve it.
STORAGE_DRIVER=local
# STORAGE_S3_BUCKET=callibrator
# STORAGE_S3_REGION=ap-southeast-1
# STORAGE_S3_ENDPOINT=http://minio:9000     # operator endpoints are NOT SSRF-checked
# STORAGE_S3_FORCE_PATH_STYLE=true          # required by MinIO and most non-AWS
# STORAGE_S3_PREFIX=prod                    # convenience, NOT an isolation boundary
# Leave the key pair UNSET to use the ambient credential chain (IAM role).
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_NFS_ROOT=/mnt/callibrator
# STORAGE_NFS_FSYNC=true                    # an NFS client can ack a write still in its page cache

# ==========================================================================
# VIRUS SCANNING
# ==========================================================================
# VIRUS_SCAN_FAIL_OPEN defaults to false: a scanner ERROR rejects the upload.
# Fail-closed is inconvenient when ClamAV is down and correct anyway — the
# alternative silently disables scanning at the moment it is not working.
VIRUS_SCAN_PROVIDER=clamav
VIRUS_SCAN_FAIL_OPEN=false
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ==========================================================================
# WEBAUTHN
# ==========================================================================
# RP_ID is the registrable domain: NO scheme, NO port.
# ORIGIN must match the browser origin EXACTLY.
# WEBAUTHN_RP_ID=callibrator.example.com
# WEBAUTHN_ORIGIN=https://callibrator.example.com

# ==========================================================================
# BATCH JOBS
# ==========================================================================
# Leave UNSET outside development. Inline mode makes a job synchronous with
# whatever triggered it, reintroducing the 30s timeout it exists to avoid.
# BATCH_JOBS_INLINE=false
# BATCH_PREFETCH=5

# ==========================================================================
# SCHEDULERS  (node-cron)
# ==========================================================================
# Each is installed in every replica. The singleton jobs claim their
# scheduled minute in Redis first, so a second replica skips them (S-33) — but
# the claim is skipped while Redis is down, so still run schedulers on ONE
# instance. `disabled` turns a job off. Unset = the application default.
# SCHEDULERS_ENABLED=false turns off every singleton job at once (W-02); the
# webhook dispatcher is exempt (replica-safe, ADR-054).
# SCHEDULERS_ENABLED=true
SESSION_CLEANUP_SCHEDULER=0 2 * * *
BACKUP_SCHEDULER=0 3 * * 0
RETENTION_SCHEDULER=0 2 * * *
# CALIBRATION_SCHEDULER=0 1 * * *
# TENANT_LIFECYCLE_SCHEDULER=30 2 * * *
# QUARANTINE_SWEEP_SCHEDULER=17 * * * *       # S-33: abandoned uploads
# WEBHOOK_DISPATCH_SCHEDULER=*/15 * * * * *   # durable webhook retries (A-10)
# QUARANTINE_MAX_AGE_MINUTES=60
# BACKUP_KEEP_MIN=3                           # newest backups never pruned
# BACKUP_RETENTION_DAYS=30

# ==========================================================================
# ALERTING  (P7-02 — docs/DEVOPS/07-ALERTING.md)
# ==========================================================================
# Every scheduled-job failure, missed run and stuck batch job is logged at
# `error` with an `alert.key` field (always on). These add push channels:
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/…   # a credential: keep it here, not in git
# ALERT_EMAIL_TO=oncall@example.com                      # via the MAIL_* transport
# JOB_WATCHDOG_SCHEDULER=*/5 * * * *                     # missed-run + stuck-batch checks
# JOB_OVERDUE_GRACE_MINUTES=60
# JOB_ALERT_REPEAT_HOURS=24                              # re-alert a still-failing job
# BATCH_JOB_STUCK_MINUTES=60
# Prometheus scrape of /api/v1/health/metrics with `Authorization: Bearer …`;
# unset = the endpoint answers 404. At least 32 characters.
# METRICS_TOKEN=

# ==========================================================================
# BILLING
# ==========================================================================
# A LIVE key with NODE_ENV != production passes every per-field check and will
# charge a real card from a test. The reverse — a sandbox key in production —
# makes every order look paid while no money arrives, and nothing errors.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ==========================================================================
# AI / RAG   (PostgreSQL only — pgvector)
# ==========================================================================
# Per-tenant keys override these. That is a data-residency control, not a
# billing convenience.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================================================
# CUSTOM DOMAINS / TLS
# ==========================================================================
# CUSTOM_DOMAINS_ENABLED=true
# TLS_AUTO_PROVISION=true
# DEFAULTS TO THE LET'S ENCRYPT STAGING DIRECTORY. Forgetting to change it in
# production yields certificates no browser trusts, and the failure appears in
# a browser rather than in any log.
# ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# ACME_ACCOUNT_EMAIL=admin@example.com

# ==========================================================================
# FRONTEND  (INLINED AT BUILD TIME — not read at runtime)
# ==========================================================================
# A different API URL means a DIFFERENT IMAGE. Setting these in the container
# environment does nothing.
NEXT_PUBLIC_API_BASE_URL=https://callibrator.example.com
NEXT_PUBLIC_API_VERSION=v1
# Set to a tenant UUID for a single-tenant branded build; leave empty for the
# default multi-tenant build.
NEXT_PUBLIC_TENANT_ID=

# ==========================================================================
# BOOTSTRAP
# ==========================================================================
# Seeding is NOT automatic. The database comes up with 72 tables and ZERO
# rows, so no account exists to log in with until it is seeded.
#
# GET /api/v1/migration/seeding is gated by superAdminOrBootstrap: it needs a
# super-admin token, which cannot exist before the first seed. ALLOW_SEEDING
# breaks that chicken-and-egg by permitting the call unauthenticated.
#
# TURN IT OFF AGAIN IMMEDIATELY AFTER SEEDING - it is an unauthenticated
# endpoint that writes to the database.
ALLOW_SEEDING=false

# ==========================================================================
# REVERSE-PROXY DEPLOYMENTS
# ==========================================================================
# Server-only: deliberately no NEXT_PUBLIC_ prefix, so it is never inlined
# into the client bundle.
#
# NEXT_PUBLIC_API_BASE_URL is read from two places with DIFFERENT reachability
# needs - server-side by the Next proxy routes, and client-side by Socket.IO.
# Behind a proxy those are not the same URL: a server-side hop to the public
# origin re-enters the proxy that called it and loops.
#
# Set this to the backend service address whenever /api/ is routed to Next.js.
BACKEND_INTERNAL_URL=http://backend:3000

# ==========================================================================
# DEVELOPMENT ONLY
# ==========================================================================
# MUST NEVER be true in production — a demo seeder against real data is a
# data-integrity incident.
# SEED_DEMO=false
# BACKEND_PORT=3000
# FRONTEND_PORT=3001
# POSTGRES_PORT=5432
# PGADMIN_EMAIL=pgadmin@local.dev
# PGADMIN_PASSWORD=pgadmin
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# A-67/A-16: count failed logins per client IP. Leave unset (off) until the
# backend sees the real client IP behind the Next proxy; while every browser
# shares one address, per-IP counting lets anyone lock login for everyone.
# AUTH_RATE_LIMIT_BY_IP=true

# A-171: the public origin of the web FRONT END, with no trailing slash. Every
# link the backend emails (e-signature requests and completions, custom-domain
# verification) and the SSO callback redirect is built on it. Behind the
# bundled nginx it is the same origin as HOST_URL; set it explicitly anyway:
# unset, the SSO redirect falls back to http://localhost:3000.
FRONTEND_URL=https://callibrator.example.com
