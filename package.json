{
  "name": "hospital-calibrator",
  "version": "0.1.0",
  "private": true,
  "description": "Hospital Device Calibration Platform - Multi-tenant SaaS",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "cd backend && npm run migrate",
    "db:migrate:undo": "cd backend && npm run migrate:undo",
    "db:psql": "cd backend && npm run db:psql"
  },
  "devDependencies": {
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "eslint": "9.22.0"
  }
}
