{
  "name": "hospital-calibrator",
  "version": "0.1.0",
  "private": true,
  "description": "Hospital Device Calibration Platform - Multi-tenant SaaS",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "cd backend && npm run migrate",
    "db:migrate:undo": "cd backend && npm run migrate:undo",
    "db:psql": "cd backend && npm run db:psql"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.5"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "eslint": "9.39.5",
    "sequelize": {
      "uuid": "11.1.1"
    },
    "@scalar/api-reference": {
      "ai": "^6.0.296",
      "@ai-sdk/vue": "^3.0.296",
      "@ai-sdk/provider-utils": "^4.0.56",
      "@ai-sdk/gateway": "^3.0.205",
      "undici": "^7.29.1"
    },
    "openapi-typescript": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "brace-expansion": false,
    "cliui": false,
    "content-type": false,
    "core-js": false,
    "eslint-visitor-keys": false,
    "glob": false,
    "globals": false,
    "jackspeak": false,
    "lru-cache": false,
    "next-bun-compile": false,
    "path-scurry": false,
    "puppeteer": false,
    "signal-exit": false,
    "undici": false,
    "yallist": false,
    "yargs": false,
    "yargs-parser": false,
    "vue-demi": false
  }
}
