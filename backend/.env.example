# Callibrator Backend - Environment Configuration
# Copy this file to .env and fill in the values
#
# CANONICAL TEMPLATES (S-25) — there are exactly two, one per way of running:
#   backend/.env.example         THIS FILE. A source checkout: `node index.js`
#                                / `npm run dev` from backend/, datastores on
#                                localhost.
#   deploy/compose/.env.example  The compose stack (`make env`): service
#                                hostnames, production defaults.
# backend/local.env, a stale third template with none of the required
# secrets, was DELETED on 2026-09-24 (S-25). Every env filename other than the
# two templates is git-ignored (.gitignore: .env, .env.*, *.env).

# ==========================================
# DATABASE (PostgreSQL only — ADR-039; DB_DIALECT may be omitted)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callibrator
DB_USER=postgres
DB_PASS=your_db_password
DB_DIALECT=postgres
DB_SSL=false
# P6-03 — the NOLOGIN role (migration 0057) every connection drops to after
# migrating: no UPDATE/DELETE on calibration_records. Unset = run as DB_USER.
# DB_APP_ROLE=callibrator_app
# SCHEMA_VERIFY=warn   # P6-05: log schema mismatches instead of refusing to boot (recovery only)
# DB_SSL_CA=/path/to/ca-cert.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# ==========================================
# DATABASE CONNECTION POOL
# ==========================================
# DB_POOL_MAX=10          — Max connections (default: 10 dev / 20 prod)
# DB_POOL_MIN=2           — Min connections (default: 2)
# DB_POOL_ACQUIRE_TIMEOUT=30000 — Max ms to wait for a connection (default: 30000)
# DB_POOL_IDLE_TIMEOUT=10000      — Max ms an idle connection can remain (default: 10000)

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://localhost:6379
# Or use host/port:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# S-09: when Redis runs with requirepass / an ACL user. Unset = no AUTH.
# Credentials inside REDIS_URL also work and take precedence — use one or the
# other.
# REDIS_PASSWORD=
# REDIS_USERNAME=

# ==========================================
# RABBITMQ
# ==========================================
RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_PORT=5672

# ==========================================
# MQTT (IoT Device Data)
# ==========================================
# MQTT_HOST=localhost
# MQTT_PORT=1883

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRED=15m
JWT_REFRESH_SECRET=change-this-to-another-long-random-string
JWT_REFRESH_EXPIRED=7d

# ==========================================
# APP
# ==========================================
NODE_ENV=development
HOST_URL=http://localhost:5000
APP_STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760
# 10MB in bytes

# Certificate-PDF rendering uses puppeteer. In a compiled binary (pkg / bun) the
# bundled Chromium is NOT available — point this at a system Chromium/Chrome.
# The Docker runtime image installs chromium and sets this automatically.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ==========================================
# OBJECT STORAGE (platform default)
# ==========================================
# Where files live when a tenant has not brought its own storage.
# local = the app server's disk | s3 = any S3-compatible bucket | nfs = a mount
# A tenant can override this with its own bucket (see the storage settings API),
# which moves that tenant's storage cost and capacity off the platform.
STORAGE_DRIVER=local

# --- local ---
# Defaults to <app storage>/storage when unset.
# STORAGE_LOCAL_ROOT=./storage/objects

# --- nfs ---
# STORAGE_NFS_ROOT=/mnt/callibrator
# fsync after every write. Defaults to true: an NFS client can otherwise
# acknowledge a write that is still only in its own page cache.
# STORAGE_NFS_FSYNC=true

# --- s3 (AWS S3, MinIO, Cloudflare R2, Wasabi, DO Spaces) ---
# STORAGE_S3_BUCKET=callibrator
# STORAGE_S3_REGION=ap-southeast-1
# Custom endpoint for non-AWS. Operator-set endpoints may be internal
# (e.g. http://minio:9000); tenant-supplied ones are SSRF-checked.
# STORAGE_S3_ENDPOINT=http://minio:9000
# Required by MinIO and most non-AWS providers. Default true.
# STORAGE_S3_FORCE_PATH_STYLE=true
# Optional prefix inside the bucket, for sharing one bucket across envs.
# STORAGE_S3_PREFIX=prod
# Leave both unset to use the ambient credential chain (IAM role) — preferred.
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ==========================================
# EMAIL (Nodemailer)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@callibrator.app

# ==========================================
# SUPER ADMIN
# ==========================================
SUPER_ADMIN_ROLE_ID=uuid-here

# ==========================================
# CRON SCHEDULERS (optional, use node-cron format)
# ==========================================
# W-02: SCHEDULERS_ENABLED=false switches off EVERY singleton scheduler on this
# instance (an API replica), whatever the variables below say. Default: on.
# The webhook dispatcher is exempt: it is safe on every replica (ADR-054).
# SCHEDULERS_ENABLED=true
# SESSION_CLEANUP_SCHEDULER=0 2 * * *
# CALIBRATION_SCHEDULER=0 1 * * *          # daily 01:00; set "disabled" to turn off
# QUARANTINE_SWEEP_SCHEDULER=17 * * * *    # S-33: abandoned uploads
# WEBHOOK_DISPATCH_SCHEDULER=*/15 * * * * * # durable webhook retries (A-10)
# BACKUP_SCHEDULER=0 3 * * 0

# Signing / encryption secrets — REQUIRED (application fails fast if unset).
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CERT_SIGNING_SECRET  : HMAC key for calibration-certificate QR/verification signatures.
# ENCRYPT_KEY          : key material for encrypting e-signature private keys at rest.
# ATTACHMENT_URL_SECRET: HMAC key for signed attachment download URLs.
CERT_SIGNING_SECRET=CHANGE_ME_64_HEX
ENCRYPT_KEY=CHANGE_ME_64_HEX
ATTACHMENT_URL_SECRET=CHANGE_ME_64_HEX
# KMS_MASTER_KEY: wraps tenant storage credentials and TLS private keys
# (src/services/kms.service.js). REQUIRED when NODE_ENV=production — the
# service refuses to start without a 64-char hex key. Outside production an
# unset key falls back to a mock key derived from a constant in that file, so
# anything wrapped in development is NOT protected. Same generator as above.
# Left COMMENTED on purpose: a placeholder here is not "unset" — it fails the
# 32-byte check and stops the backend even in development.
# KMS_MASTER_KEY=<64 hex chars>

# Public frontend certificate-validation page base; QR encodes <this>/<certificateNumber>
CERT_VERIFY_BASE_URL=http://localhost:3000/verify

# ==========================================
# FEATURE MODULES — new architecture (match docker-compose services)
# All are optional and safe to leave unset in dev; each feature degrades or
# stays disabled until its backing service is configured.
# ==========================================

# --- Attachment virus scanning (ClamAV) ---
# VIRUS_SCAN_PROVIDER=none keeps uploads unscanned (dev default). Set to
# "clamav" to enforce scanning via the clamav compose service. On a scanner
# error the default is FAIL-CLOSED (upload rejected); VIRUS_SCAN_FAIL_OPEN=true
# reverses that. CLAMAV_HOST is the compose service name.
# VIRUS_SCAN_PROVIDER=clamav
# VIRUS_SCAN_FAIL_OPEN=false
# CLAMAV_ENABLED=true
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# --- WebAuthn / passkeys (challenge store lives in Redis) ---
# WEBAUTHN_RP_ID must be the site's registrable domain (no scheme/port).
# WEBAUTHN_ORIGIN must exactly match the browser origin.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000

# --- Batch jobs (RabbitMQ worker) ---
# BATCH_JOBS_INLINE=true processes jobs in-process (no broker) for local dev;
# leave unset in production to use the RabbitMQ worker.
# BATCH_JOBS_INLINE=false
# BATCH_PREFETCH=5

# --- Data-retention purge scheduler (node-cron) ---
# RETENTION_SCHEDULER=0 2 * * *   # daily 02:00; set "disabled" to turn off

# --- Tenant-lifecycle scheduler (node-cron; W-01) ---
# Offboards suspended tenants whose grace period has passed.
# TENANT_LIFECYCLE_SCHEDULER=30 2 * * *   # daily 02:30; set "disabled" to turn off
# TENANT_GRACE_PERIOD_DAYS=7              # grace granted by POST /tenants/:id/grace-period
# TENANT_OFFBOARD_RETENTION_DAYS=30       # data held after offboarding before hard delete

# --- AI / RAG (OpenAI-compatible; per-tenant keys override these) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Custom-domain TLS provisioning (ACME / Let's Encrypt) ---
# CUSTOM_DOMAINS_ENABLED=true
# TLS_AUTO_PROVISION=true
# ACME_DIRECTORY_URL defaults to the LE STAGING directory; point at the
# production directory for real certificates.
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_ACCOUNT_EMAIL=admin@example.com

# A-67/A-16: count failed logins per client IP. Leave unset (off) until the
# backend sees the real client IP behind the Next proxy; while every browser
# shares one address, per-IP counting lets anyone lock login for everyone.
# AUTH_RATE_LIMIT_BY_IP=true

# A-171: the public origin of the web FRONT END, with no trailing slash. Every
# link the backend emails (e-signature requests and completions, custom-domain
# verification) and the SSO callback redirect is built on it. Unset, emailed
# links fall back to HOST_URL, which in local development is the BACKEND
# (:5000) and serves no page; the SSO redirect falls back to
# http://localhost:3000. In production it is the address users type.
FRONTEND_URL=http://localhost:3000

# ==========================================
# OPERATIONS (P7-02, P7-08)
# ==========================================
# Scheduled-job alerts. Failures are always logged at `error` with an
# `alert.key` field; these add push channels. docs/DEVOPS/07-ALERTING.md.
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL_TO=
# JOB_STATUS_DIR=            # default <storage>/log/jobs
# JOB_WATCHDOG_SCHEDULER=*/5 * * * *
# Prometheus scrape of GET /api/v1/health/metrics (Bearer; >= 32 chars; unset = 404).
# METRICS_TOKEN=
# Swagger UI (/docs, /docs.json): on outside production, OFF in production
# unless SWAGGER_ENABLED=true (S-23). "false" turns it off everywhere.
# SWAGGER_ENABLED=
