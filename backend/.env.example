# Callibrator Backend - Environment Configuration
# Copy this file to .env and fill in the values
#
# CANONICAL TEMPLATES (S-25) — there are exactly two, one per way of running:
#   backend/.env.example         THIS FILE. A source checkout: `node index.js`
#                                / `npm run dev` from backend/, datastores on
#                                localhost.
#   deploy/compose/.env.example  The compose stack (`make env`): service
#                                hostnames, production defaults.
# backend/local.env, a stale third template with none of the required
# secrets, was DELETED on 2026-09-24 (S-25). Every env filename other than the
# two templates is git-ignored (.gitignore: .env, .env.*, *.env).

# ==========================================
# DATABASE (PostgreSQL only — ADR-039; DB_DIALECT may be omitted)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callibrator
DB_USER=postgres
DB_PASS=your_db_password
DB_DIALECT=postgres
DB_SSL=false
# P6-03 — the NOLOGIN role (migration 0057) every connection drops to after
# migrating: no UPDATE/DELETE on calibration_records. Unset = run as DB_USER.
# DB_APP_ROLE=callibrator_app
# SCHEMA_VERIFY=warn   # P6-05: log schema mismatches instead of refusing to boot (recovery only)
# DB_SSL_CA=/path/to/ca-cert.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# ==========================================
# DATABASE CONNECTION POOL
# ==========================================
# DB_POOL_MAX=10          — Max connections (default: 10 dev / 20 prod)
# DB_POOL_MIN=2           — Min connections (default: 2)
# DB_POOL_ACQUIRE_TIMEOUT=30000 — Max ms to wait for a connection (default: 30000)
# DB_POOL_IDLE_TIMEOUT=10000      — Max ms an idle connection can remain (default: 10000)

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://localhost:6379
# Or use host/port:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# S-09: when Redis runs with requirepass / an ACL user. Unset = no AUTH.
# Credentials inside REDIS_URL also work and take precedence — use one or the
# other.
# REDIS_PASSWORD=
# REDIS_USERNAME=

# ==========================================
# RABBITMQ
# ==========================================
RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_PORT=5672

# ==========================================
# MQTT (IoT Device Data)
# ==========================================
# MQTT_HOST=localhost
# MQTT_PORT=1883
# W-14 (ADR-079): replicas share one subscription; "none" = plain device/# (one replica only)
# MQTT_SHARED_GROUP=callibrator
# MQTT_INGEST_CONCURRENCY=8

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRED=15m
JWT_REFRESH_SECRET=change-this-to-another-long-random-string
JWT_REFRESH_EXPIRED=7d
# JWT_ALGORITHM: optional, default HS256. One of HS256/384/512, RS256/384/512,
# ES256/384/512 (utils/jwt.util pins the list, A-31); anything else stops the boot.
# JWT_ALGORITHM=

# ==========================================
# APP
# ==========================================
NODE_ENV=development
HOST_URL=http://localhost:5000
APP_STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760
# 10MB in bytes

# The backend renders no certificate PDF (M-11, ADR-095): the frontend renders it
# from GET /api/v1/certificates/:id/document. PUPPETEER_EXECUTABLE_PATH is gone.

# ==========================================
# OBJECT STORAGE (platform default)
# ==========================================
# Where files live when a tenant has not brought its own storage.
# local = the app server's disk | s3 = any S3-compatible bucket | nfs = a mount
# A tenant can override this with its own bucket (see the storage settings API),
# which moves that tenant's storage cost and capacity off the platform.
STORAGE_DRIVER=local

# --- local ---
# Defaults to <app storage>/storage when unset.
# STORAGE_LOCAL_ROOT=./storage/objects

# --- nfs ---
# STORAGE_NFS_ROOT=/mnt/callibrator
# fsync after every write. Defaults to true: an NFS client can otherwise
# acknowledge a write that is still only in its own page cache.
# STORAGE_NFS_FSYNC=true

# --- s3 (AWS S3, MinIO, Cloudflare R2, Wasabi, DO Spaces) ---
# STORAGE_S3_BUCKET=callibrator
# STORAGE_S3_REGION=ap-southeast-1
# Custom endpoint for non-AWS. Operator-set endpoints may be internal
# (e.g. http://minio:9000); tenant-supplied ones are SSRF-checked.
# STORAGE_S3_ENDPOINT=http://minio:9000
# Required by MinIO and most non-AWS providers. Default true.
# STORAGE_S3_FORCE_PATH_STYLE=true
# Optional prefix inside the bucket, for sharing one bucket across envs.
# STORAGE_S3_PREFIX=prod
# Leave both unset to use the ambient credential chain (IAM role) — preferred.
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ==========================================
# EMAIL (Nodemailer)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@callibrator.app

# ==========================================
# SUPER ADMIN
# ==========================================
# Leave unset: the default is the id the role seed writes (ROLE_IDS.SUPER_ADMIN,
# constants/roleConstants.ts). A value that is not that seeded id breaks the id
# half of the super-admin checks; the old placeholder "uuid-here" was not even a
# UUID, so every request naming the real role failed validation (CI, 2026-10-02).
# SUPER_ADMIN_ROLE_ID=9be20605-cc6a-4d91-8246-9756b4a1754b

# ==========================================
# CRON SCHEDULERS (optional, use node-cron format)
# ==========================================
# W-02: SCHEDULERS_ENABLED=false switches off EVERY singleton scheduler on this
# instance (an API replica), whatever the variables below say. Default: on.
# The webhook dispatcher is exempt: it is safe on every replica (ADR-054).
# SCHEDULERS_ENABLED=true
# SESSION_CLEANUP_SCHEDULER=0 2 * * *
# CALIBRATION_SCHEDULER=0 1 * * *          # daily 01:00; set "disabled" to turn off
# CALIBRATION_SCAN_TX_BATCH_SIZE=25        # W-17/ADR-073: due devices of one tenant per transaction
# QUARANTINE_SWEEP_SCHEDULER=17 * * * *    # S-33: abandoned uploads
# UPSTREAM_SQL_IMPORT_SWEEP_SCHEDULER=41 * * * *  # P24-06: interrupted SQL-dump imports, expired / orphaned dump files
# WEBHOOK_DISPATCH_SCHEDULER=*/15 * * * * * # durable webhook retries (A-10)
# WEBHOOK_EMIT_CONCURRENCY=10              # W-17/ADR-073: first attempts in flight per process; the rest wait for the dispatcher
# WEBHOOK_DELIVERY_PURGE_SCHEDULER=43 3 * * *   # ADR-070: finished deliveries past retention
# WEBHOOK_DELIVERY_RETENTION_DAYS=30            # never below 7
# WEBHOOK_DELIVERY_PURGE_BATCH=1000             # rows per statement
# WEBHOOK_DELIVERY_PURGE_MAX_ROWS=50000         # rows per run
# ATTACHMENT_FILE_SWEEP_SCHEDULER=13 4 * * *    # D-22/ADR-083: files of attachments deleted past retention
# ATTACHMENT_FILE_RETENTION_DAYS=90             # never below 30; a parent's restore brings files back until then
# ATTACHMENT_FILE_SWEEP_BATCH=200               # rows per transaction
# ATTACHMENT_FILE_SWEEP_MAX_ROWS=5000           # rows examined per run
# BACKUP_SCHEDULER=0 3 * * 0

# Signing / encryption secrets — REQUIRED (application fails fast if unset).
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CERT_SIGNING_SECRET  : HMAC key for calibration-certificate QR/verification signatures.
# ENCRYPT_KEY          : key material for encrypting e-signature private keys at rest.
# ATTACHMENT_URL_SECRET: HMAC key for signed attachment download URLs.
CERT_SIGNING_SECRET=CHANGE_ME_64_HEX
ENCRYPT_KEY=CHANGE_ME_64_HEX
ATTACHMENT_URL_SECRET=CHANGE_ME_64_HEX
# Signed download links (A-365, config/signedUrl.ts): the lifetime when the
# caller names none, and the cap on what a caller may ask for. Both are
# clamped: at least 30 s, the default never above the cap, the cap never
# above 3600 s. A request above the cap answers 400.
# ATTACHMENT_URL_TTL_SEC=300
# ATTACHMENT_URL_MAX_TTL_SEC=900
# KMS_MASTER_KEY: wraps tenant storage credentials and TLS private keys
# (src/services/kms.service.js). REQUIRED when NODE_ENV=production — the
# service refuses to start without a 64-char hex key. Outside production an
# unset key falls back to a mock key derived from a constant in that file, so
# anything wrapped in development is NOT protected. Same generator as above.
# Left COMMENTED on purpose: a placeholder here is not "unset" — it fails the
# 32-byte check and stops the backend even in development.
# KMS_MASTER_KEY=<64 hex chars>
# KMS_MASTER_KEY_PREVIOUS: optional, comma-separated 64-hex keys still READ
# during a rotation (docs/SECURITY/13-KEY-ROTATION.md); each must be 32 bytes.
# KMS_MASTER_KEY_PREVIOUS=

# Public frontend certificate-validation page base; QR encodes <this>/<certificateNumber>
CERT_VERIFY_BASE_URL=http://localhost:3000/verify

# ==========================================
# FEATURE MODULES — new architecture (match docker-compose services)
# All are optional and safe to leave unset in dev; each feature degrades or
# stays disabled until its backing service is configured.
# ==========================================

# --- Attachment virus scanning (ClamAV) ---
# VIRUS_SCAN_PROVIDER=none keeps uploads unscanned (dev default). Set to
# "clamav" to enforce scanning via the clamav compose service. On a scanner
# error the default is FAIL-CLOSED (upload rejected); VIRUS_SCAN_FAIL_OPEN=true
# reverses that. CLAMAV_HOST is the compose service name.
# VIRUS_SCAN_PROVIDER=clamav
# VIRUS_SCAN_FAIL_OPEN=false
# CLAMAV_ENABLED=true
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# --- WebAuthn / passkeys (challenge store lives in Redis) ---
# WEBAUTHN_RP_ID must be the site's registrable domain (no scheme/port).
# WEBAUTHN_ORIGIN must exactly match the browser origin.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000

# --- Batch jobs (RabbitMQ worker) ---
# BATCH_JOBS_INLINE=true processes jobs in-process (no broker) for local dev;
# leave unset in production to use the RabbitMQ worker.
# BATCH_JOBS_INLINE=false
# BATCH_PREFETCH=5

# --- Data-retention purge scheduler (node-cron) ---
# RETENTION_SCHEDULER=0 2 * * *   # daily 02:00; set "disabled" to turn off

# --- Tenant-lifecycle scheduler (node-cron; W-01) ---
# Offboards suspended tenants whose grace period has passed.
# TENANT_LIFECYCLE_SCHEDULER=30 2 * * *   # daily 02:30; set "disabled" to turn off
# TENANT_GRACE_PERIOD_DAYS=7              # grace granted by POST /tenants/:id/grace-period
# TENANT_OFFBOARD_RETENTION_DAYS=30       # data held after offboarding before hard delete

# --- AI / RAG (OpenAI-compatible; per-tenant keys override these) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# A-176 — SSRF guard for URLs a TENANT chooses and the server calls
# (oidc_authority and what its IdP publishes, ai_base_url, a tenant S3
# endpoint). Loopback, private, link-local/metadata and ULA addresses are
# refused, at save time and again (DNS-pinned) at every call. For local
# development against an internal service — a Keycloak container, a local
# model server — name its hosts here, comma-separated. IGNORED when
# NODE_ENV=production.
# SSRF_DEV_ALLOW_HOSTS=localhost,127.0.0.1,keycloak

# --- Custom domains (registration + DNS verification only) ---
# CUSTOM_DOMAINS_ENABLED=true
# No certificate is issued automatically (A-256; acme-client removed, ADR-076).
# TLS_AUTO_PROVISION and ACME_* are not read (ADR-081).

# A-67/A-16, ADR-100: count failed sign-ins per client IP as well as per
# account. Unset, it is ON in production and off elsewhere (since A-16 the
# edge-resolved client address reaches the backend as req.ip). Set "false" on
# a deployment whose proxy chain does not deliver the client address — there
# every browser shares one address and per-IP counting would let anyone pause
# sign-in for everyone.
# AUTH_RATE_LIMIT_BY_IP=true
# ADR-100: the public auth/verification request budgets
# (constants/rateLimitConstants.ts API_ENDPOINTS) are production figures;
# outside production they are multiplied by this (default 100).
# RATE_LIMIT_NON_PRODUCTION_FACTOR=100
# W-19 (ADR-079): the most keys the in-memory fallback (Redis down) holds
# RATE_LIMIT_MEMORY_MAX_KEYS=100000

# A-171: the public origin of the web FRONT END, with no trailing slash. Every
# link the backend emails (e-signature requests and completions, custom-domain
# verification) and the SSO callback redirect is built on it. Unset, emailed
# links fall back to HOST_URL, which in local development is the BACKEND
# (:5000) and serves no page; the SSO redirect falls back to
# http://localhost:3000. In production it is the address users type.
FRONTEND_URL=http://localhost:3000

# ==========================================
# OPERATIONS (P7-02, P7-08)
# ==========================================
# Scheduled-job alerts. Failures are always logged at `error` with an
# `alert.key` field; these add push channels. docs/DEVOPS/07-ALERTING.md.
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL_TO=
# JOB_STATUS_DIR=            # default <storage>/log/jobs
# JOB_WATCHDOG_SCHEDULER=*/5 * * * *
# Prometheus scrape of GET /api/v1/health/metrics (Bearer; >= 32 chars; unset = 404).
# METRICS_TOKEN=
# The API reference (Scalar at /docs and /api/v1/docs, the spec at /docs.json):
# mounted outside production, NOT in production unless SWAGGER_ENABLED=true
# (S-23). "false" turns it off everywhere. Since P9-25 (ADR-103) it is always
# behind sign-in (tenant admin or super admin); no value publishes it anonymously.
# SWAGGER_ENABLED=

# ---------------------------------------------------------------------------
# Billing (Stripe) — ADR-111
# ---------------------------------------------------------------------------
# BILLING_ENABLED: "true" / "false" decide. Unset, billing is enabled exactly
# when STRIPE_WEBHOOK_SECRET is set (a deployment wired to Stripe).
# In PRODUCTION with billing enabled, STRIPE_SECRET_KEY is REQUIRED: the
# backend refuses to start without it. Elsewhere a placeholder stands in.
# BILLING_ENABLED=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Phase 10 (ADR-098) — the public ways in
# ---------------------------------------------------------------------------
# P10-12: POST /auth/register exists only where self-registration is enabled.
# "true" / "false" decide; unset means OFF in production and ON elsewhere.
# Off, the route answers 404 like an absent one. Request access (P10-05) is
# the way in; a self-registered account has no tenant (ADR-075).
# SELF_REGISTRATION_ENABLED=
# P10-05: the internal inbox told that a new access request arrived (the
# organisation's name and a link to the queue only — never the requester's
# contact details). Unset: no notification; the queue page is the source.
# ACCESS_REQUEST_NOTIFY_EMAIL=
# P10-05: the secret mixed into the hashed client address stored with each
# access request (the raw address is never stored). REQUIRED in production:
# the server refuses to start without it. Generate: openssl rand -hex 32
# ACCESS_REQUEST_IP_PEPPER=
# Q-42 (ADR-113): the published privacy notice the access-request consent
# links to — an absolute https URL. A form collecting personal data does not
# open before its notice exists: UNSET (or not an http(s) URL), POST
# /access-requests answers 404 like an absent route, in every environment.
# The frontend reads the same variable at runtime (deploy/compose passes it).
# PRIVACY_NOTICE_URL=

# ---------------------------------------------------------------------------
# P24-06 — the SQL-dump import (upstream adoption; super admin only)
# ---------------------------------------------------------------------------
# An uploaded mysqldump / MariaDB dump is PARSED, never executed, into the
# `upstream_import` staging schema by a connection that switches to the
# import role (migration 0114 creates it; the application role cannot read
# that schema). UPSTREAM_REAL_DATA_ALLOWED (the DPIA gate, docs/UPSTREAM/06)
# is shared with the rsync image import: while it is not "true" only a file
# declared synthetic is accepted, and the worker checks again before parsing.
# UPSTREAM_REAL_DATA_ALLOWED=false
# UPSTREAM_IMPORT_DB_ROLE=callibrator_import
# UPSTREAM_IMPORT_MAX_BYTES=209715200                 # 200 MiB upload cap (nginx: see deploy/compose/nginx)
# UPSTREAM_IMPORT_MAX_UNCOMPRESSED_BYTES=2147483648   # a gzip upload's decompressed ceiling
# UPSTREAM_IMPORT_FAILED_RETENTION_DAYS=7             # a failed run keeps its file this long, for a retry
# UPSTREAM_IMPORT_UPLOAD_TIMEOUT_MS=900000            # the upload request's own budget (the app's is 30 s)

# ---------------------------------------------------------------------------
# P24-07 (ADR-130) — the rsync image import (upstream adoption; super admin only)
# ---------------------------------------------------------------------------
# Copies the upstream server's device photos (foto_depan, foto_sn — never the
# certificate PDFs) over rsync/SSH into a quarantine, then ingests them into a
# tenant's storage (docs/UPSTREAM/08-FILE-POLICY.md § 11). The backend image
# ships rsync, openssh-client and sshpass. UPSTREAM_REAL_DATA_ALLOWED above is
# the shared DPIA gate: while it is not "true" only a source declared synthetic,
# on a host listed in RSYNC_ALLOWED_HOSTS, is accepted.
#
# RSYNC_ALLOWED_HOSTS: host names / addresses an import may reach although they
# resolve to a private, loopback or link-local address (a test SSH server on
# this deployment's network). Applies in production too. Empty: only public hosts.
# RSYNC_ALLOWED_HOSTS=
# UPSTREAM_FILE_IMPORT_DIR=          # default <storage root>/.upstream-import (staging, refused files, manifests)
# RSYNC_CHECK_TIMEOUT_MS=120000      # one step of "check connection" (key scan, dry-run listing)
# RSYNC_IO_TIMEOUT_SEC=300           # rsync --timeout: a stalled transfer ends after this long
