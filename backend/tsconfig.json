{
  // Backend compiler settings — ADR-038, docs/ENGINEERING/04-TYPESCRIPT-STANDARDS.md,
  // P9-01. The mixed JS/TS arrangement these settings serve is ADR-087.
  //
  // This file is what `npm run typecheck` (P9-01a), the editor and ts-jest
  // read. The release build reads tsconfig.build.json, which extends it.
  //
  // Weakening a flag here is a decision, not a convenience: it needs an ADR.
  "compilerOptions": {
    // Node 26 is the runtime (the owner's 2026-09-27 instruction); ES2025 is
    // the newest target TypeScript 6.0 accepts, and Node 26 implements it.
    "target": "ES2025",
    "lib": ["ES2025"],
    // CommonJS emitted from `import` syntax: package.json stays
    // "type": "commonjs", so Node16 emits CJS for every .ts file (ADR-038).
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // The ONE allowed relaxation: it skips type-checking third-party .d.ts
    // files (node_modules). It never hides an error in our own code — our
    // code has no .d.ts files outside src/types, and those are checked as
    // part of the program regardless.
    "skipLibCheck": true,

    // `verbatimModuleSyntax` is deliberately NOT set. It is incompatible with
    // emitting CommonJS from `import` syntax, which ADR-038 requires. Turning
    // it on does not fail here — it fails later, inside the pkg binary.

    // For the .js TESTS only (ADR-109 §5, P9-24): `typecheck` must still read
    // the existing .js test files that import .ts source, until P9-26 converts
    // them; then this goes. SOURCE is held .js-free twice: the release build
    // sets it to false (tsconfig.build.json), so a .ts file importing a .js
    // one fails the build (ADR-038 rule 1), and the guard
    // src/tests/guards/noSourceJs.p924.guard.test.ts fails on any non-test .js
    // in the counted set (index, src/** outside src/tests/, scripts/**).
    "allowJs": true,
    "checkJs": false,

    // TypeScript 6 no longer loads every @types package by default.
    "types": ["node", "jest"]
  },
  "include": ["index.ts", "src/**/*.ts", "scripts/**/*.ts", "__tests__/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
