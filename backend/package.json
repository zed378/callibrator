{
  "name": "callibrator-backend",
  "version": "1.0.0",
  "description": "Callibrator API: multi-tenant hospital medical-device calibration, maintenance and lifecycle management (Express, PostgreSQL).",
  "keywords": [
    "docker",
    "nodejs",
    "expressjs",
    "backend"
  ],
  "bin": "dist/index.js",
  "pkg": {
    "assets": [
      "src/templates/**/*",
      "node_modules/swagger-ui-dist/**/*",
      "../node_modules/swagger-ui-dist/**/*",
      "swagger.json",
      "docs"
    ],
    "scripts": [
      "dist/src/**/*.js"
    ],
    "targets": [
      "node26-linux-x64",
      "node26-win-x64"
    ],
    "outputPath": "dist"
  },
  "license": "MIT",
  "author": "zed378",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../node_modules/jest/bin/jest.js --forceExit",
    "test:unit": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../node_modules/jest/bin/jest.js --forceExit",
    "test:e2e": "jest --config jest.e2e.config.js --forceExit --runInBand",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../node_modules/jest/bin/jest.js --coverage",
    "start": "node --import tsx index.js",
    "dev": "tsx watch index.js",
    "build": "npm run swagger:generate && npm run build:dist && pkg . --output dist/backend",
    "build:dist": "tsx scripts/build-dist.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "swagger:generate": "tsx src/utils/generateSwagger.util.js",
    "migrate": "tsx src/scripts/migrate.js up",
    "migrate:storage": "tsx src/scripts/migrateStorage.js",
    "migrate:undo": "tsx src/scripts/migrate.js down",
    "migrate:status": "tsx src/scripts/migrate.js pending",
    "migrate:verify": "tsx src/scripts/verifySchema.js",
    "keys:rotate": "tsx src/scripts/rotateKeys.js",
    "lint": "eslint src/ scripts/build-dist.ts --ext .js,.ts",
    "lint:fix": "eslint src/ scripts/build-dist.ts --ext .js,.ts --fix",
    "prettier": "prettier --check \"src/**/*.{js,ts}\"",
    "prettier:fix": "prettier --write \"src/**/*.{js,ts}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@simplewebauthn/server": "^14.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^2.0.1",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cls-hooked": "^4.2.2",
    "compression": "^1.8.2",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "markdown-it": "^15.0.2",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.4",
    "morgan": "^1.12.1",
    "mqtt": "^5.16.0",
    "multer": "^2.4.0",
    "mustache": "^4.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.11",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^25.12.0",
    "qrcode": "^1.5.4",
    "rotating-file-stream": "^3.2.10",
    "sanitize-html": "^2.17.7",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
